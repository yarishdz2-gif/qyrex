C(RunService.Heartbeat, function()
    if KILLALL.running then return end
    local now = os.clock()
    local myCh = lp.Character
    local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return end
    local cam = workspace.CurrentCamera

    -- Trigger: mouse encima del enemigo O crosshair muy cerca
    if AUTO.trigger and cam and myCh and (now - lastTrigger) >= 0.035 then
        if not hooksInstalled then pcall(installHooks) end
        local mouse = lp:GetMouse()
        local hitPart = nil
        local under = mouse and mouse.Target
        if under then
            local model = under:FindFirstAncestorOfClass("Model")
            local victim = model and Players:GetPlayerFromCharacter(model)
            if victim and victim ~= lp then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    hitPart = aimGetPart(model) or under
                end
            end
        end
        if not hitPart then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then
                    local ch = plr.Character
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    local part = ch and aimGetPart(ch)
                    if part and hum and hum.Health > 0 then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local center = cam.ViewportSize / 2
                            local dist = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
                            if dist < 32 then
                                hitPart = part
                                break
                            end
                        end
                    end
                end
            end
        end
        if hitPart then
            SILENT.target = hitPart
            lastTrigger = now
            clickMouse()
        end
    end

    if AUTO.knife then
        local tgt = SILENT.target
        local myHRP = myCh:FindFirstChild("HumanoidRootPart")
        if tgt and myHRP and (tgt.Position - myHRP.Position).Magnitude < 14 and (now - lastKnife) >= 0.12 then
            lastKnife = now
            equipTool1()
            clickMouse()
        end
    end

