local function toolsFromBackpack()
    local list = {}
    local bag = lp:FindFirstChild("Backpack")
    if bag then
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then list[#list + 1] = t end
        end
    end
    local char = lp.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") then
                local already = false
                for _, x in ipairs(list) do if x == t then already = true break end end
                if not already then list[#list + 1] = t end
            end
        end
    end
    return list
end

local function equipToolN(n)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local tools = toolsFromBackpack()
    local tool = tools[n]
    if not tool then return false end
    -- si ya tenemos esa tool equipada, ok
    if tool.Parent == char then return true end
    -- si hay otra tool equipada distinta, quitarla primero
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and equipped ~= tool then
        pcall(function() hum:UnequipTools() end)
        task.wait(0.05)
    end
    if equipping then return false end
    equipping = true
    pcall(function() hum:EquipTool(tool) end)
    task.delay(0.2, function() equipping = false end)
    return true
end

