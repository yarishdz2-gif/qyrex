local function findEmoteFolder()
    local candidates = {
        RS:FindFirstChild("EmoteAnimations"),
        RS:FindFirstChild("Emotes"),
        RS:FindFirstChild("Animations"),
    }
    for _, c in ipairs(candidates) do
        if c then return c end
    end
    for _, d in ipairs(RS:GetDescendants()) do
        if d.Name == "EmoteAnimations" or d.Name == "EmoteAnimation" then
            return d
        end
    end
    return nil
end

local function collectGameEmotes()
    table.clear(gameEmotes)
    local folder = findEmoteFolder()
    if not folder then return end
    local function addAnim(name, anim)
        if not anim then return end
        local id = nil
        if anim:IsA("Animation") then
            id = anim.AnimationId
        elseif anim:IsA("StringValue") or anim:IsA("StringValue") then
            id = anim.Value
        elseif typeof(anim) == "Instance" and anim:GetAttribute("AnimationId") then
            id = tostring(anim:GetAttribute("AnimationId"))
        end
        if not id or id == "" then
            local child = anim:FindFirstChildOfClass("Animation")
            if child then id = child.AnimationId end
        end
        if id and id ~= "" then
            if not tostring(id):find("rbxassetid") and tonumber(id) then
                id = "rbxassetid://" .. tostring(id)
            end
            gameEmotes[#gameEmotes + 1] = { name = name, id = id, inst = anim }
        end
    end
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Animation") then
            addAnim(child.Name, child)
        elseif child:IsA("Folder") or child:IsA("ModuleScript") or child:IsA("StringValue") or child:IsA("ObjectValue") then
            local anim = child:FindFirstChildOfClass("Animation") or child
            addAnim(child.Name, anim)
        else
            addAnim(child.Name, child)
        end
    end
    table.sort(gameEmotes, function(a, b) return a.name:lower() < b.name:lower() end)
end

local function unlockAllEmotes()
    pcall(function()
        local folder = findEmoteFolder()
        if folder then
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("BoolValue") and (d.Name:lower():find("lock") or d.Name:lower():find("own")) then
                    d.Value = true
                end
                pcall(function()
                    if d:GetAttribute("Locked") ~= nil then d:SetAttribute("Locked", false) end
                    if d:GetAttribute("Owned") ~= nil then d:SetAttribute("Owned", true) end
                    if d:GetAttribute("Unlocked") ~= nil then d:SetAttribute("Unlocked", true) end
                end)
            end
        end
        for _, d in ipairs(RS:GetDescendants()) do
            local n = d.Name:lower()
            if n:find("emote") and d:IsA("BoolValue") and (n:find("lock") or n:find("own")) then
                d.Value = not n:find("lock") or true
                if n:find("lock") then d.Value = false end
                if n:find("own") or n:find("unlock") then d.Value = true end
            end
        end
        if lp:GetAttribute("EmotesUnlocked") ~= nil then
            lp:SetAttribute("EmotesUnlocked", true)
        end
    end)
    collectGameEmotes()
end

