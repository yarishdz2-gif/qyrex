local function emitParticlesOn(char, folder)
    if not char or not folder then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not hrp then return end
    local anchor = Instance.new("Part")
    anchor.Name = "VanguardKillFX"
    anchor.Size = Vector3.new(1, 1, 1)
    anchor.Transparency = 1
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CFrame = hrp.CFrame
    anchor.Parent = workspace
    for _, child in ipairs(folder:GetChildren()) do
        pcall(function()
            if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") then
                local c = child:Clone()
                c.Parent = anchor
                if c:IsA("ParticleEmitter") then
                    c.Enabled = true
                    pcall(function() c:Emit(math.clamp(c.Rate > 0 and math.floor(c.Rate * 0.4) or 40, 15, 80)) end)
                end
            elseif child:IsA("Attachment") then
                local a = child:Clone()
                a.Parent = anchor
                for _, pe in ipairs(a:GetDescendants()) do
                    if pe:IsA("ParticleEmitter") then
                        pe.Enabled = true
                        pcall(function() pe:Emit(30) end)
                    end
                end
            elseif child:IsA("BasePart") then
                local p = child:Clone()
                p.CFrame = hrp.CFrame
                p.Anchored = true
                p.CanCollide = false
                p.Parent = workspace
                for _, pe in ipairs(p:GetDescendants()) do
                    if pe:IsA("ParticleEmitter") then
                        pe.Enabled = true
                        pcall(function() pe:Emit(25) end)
                    end
                end
                task.delay(3, function() pcall(function() p:Destroy() end) end)
            end
        end)
    end
    task.delay(3.5, function() pcall(function() anchor:Destroy() end) end)
end

local function playKillShake()
    pcall(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local orig = cam.CFrame
        for i = 1, 6 do
            local o = (math.random() - 0.5) * 0.35
            cam.CFrame = orig * CFrame.new(o, o * 0.5, 0)
            task.wait(0.03)
        end
        cam.CFrame = orig
    end)
end

local function playFrostbiteKill(victimChar)
    if not KILLFX.on then return end
    local frost = findFrostbite()
    local root = victimChar and (victimChar:FindFirstChild("HumanoidRootPart") or victimChar:FindFirstChild("Head"))
    if not root then return end

    if frost then
        local audio = frost:FindFirstChild("Audio")
        if audio then
            playSoundAt(root, audio:FindFirstChild("FreezeSound") or audio:FindFirstChildWhichIsA("Sound"))
            playSoundAt(root, audio:FindFirstChild("FreezeSound2"))
        end
        local particles = frost:FindFirstChild("Particles")
        if particles then
            emitParticlesOn(victimChar, particles)
        else
            emitParticlesOn(victimChar, frost)
        end
    else
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://9113809056"
            s.Volume = 2
            s.Parent = root
            s:Play()
            task.delay(3, function() s:Destroy() end)
        end)
    end

    pcall(function()
        local clientFX = RS:FindFirstChild("ClientFX") or RS:FindFirstChild("ClientFx")
        if clientFX then
            local ks = clientFX:FindFirstChild("KillShake") or clientFX:FindFirstChild("KillSoundHandler")
            if ks and ks:IsA("ModuleScript") then
                local mod = require(ks)
                if type(mod) == "table" then
                    if mod.Play then mod.Play(victimChar) end
                    if mod.Shake then mod.Shake() end
                elseif type(mod) == "function" then
                    mod(victimChar)
                end
            end
        end
    end)

    playKillShake()
end

local function wasKilledByMe(plr, hum)
    if plr == lp then return false end
    -- tag clasico de Roblox
    local creator = hum and (hum:FindFirstChild("creator") or hum:FindFirstChild("Creator"))
    if creator and creator:IsA("ObjectValue") and creator.Value then
        local v = creator.Value
        if v == lp or (typeof(v) == "Instance" and (v == lp or v:IsDescendantOf(lp))) then
            return true
        end
        if typeof(v) == "Instance" and v:IsA("Player") and v == lp then
            return true
        end
    end
    -- si le pegamos hace poco con silent/auto/killall
    local t = lastHitByMe[plr]
    if t and (os.clock() - t) < 4 then
        return true
    end
    return false
end

local trackedHealth = {}
local function watchPlayerForKill(plr)
    if plr == lp then return end -- nunca efecto si me matan a mi
    local function hookChar(char)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not hum then return end
        trackedHealth[plr] = hum.Health
        C(hum.HealthChanged, function(hp)
            local prev = trackedHealth[plr] or hp
            trackedHealth[plr] = hp
            if not KILLFX.on then return end
            if prev > 0 and hp <= 0 then
                if wasKilledByMe(plr, hum) then
                    local now = os.clock()
                    if not lastKillFx[plr] or (now - lastKillFx[plr]) > 1.5 then
                        lastKillFx[plr] = now
                        playFrostbiteKill(char)
                    end
                end
            elseif prev > hp and hp > 0 then
                -- daño reciente: si somos el targeter actual, marcar
                if SILENT.target and char and SILENT.target:IsDescendantOf(char) then
                    markHitByMe(plr)
                end
            end
        end)
        C(hum.Died, function()
            if not KILLFX.on then return end
            if wasKilledByMe(plr, hum) then
                local now = os.clock()
                if not lastKillFx[plr] or (now - lastKillFx[plr]) > 1.5 then
                    lastKillFx[plr] = now
                    playFrostbiteKill(char)
                end
            end
        end)
    end
    if plr.Character then hookChar(plr.Character) end
    C(plr.CharacterAdded, hookChar)
end

