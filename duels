local function doClickMacro()
    if not CLICKMACRO.on then return end
    if CLICKMACRO.busy then return end
    CLICKMACRO.busy = true
    task.spawn(function()
        local ok, err = pcall(function()
            if not hooksInstalled then pcall(installHooks) end
            local mouse = lp:GetMouse()
            if not mouse then return end
            local hitCF = mouse.Hit
            if not hitCF then return end

            local fake = Instance.new("Part")
            fake.Name = "VanguardMacroTarget"
            fake.Size = Vector3.new(1, 1, 1)
            fake.Transparency = 1
            fake.CanCollide = false
            fake.Anchored = true
            fake.CFrame = hitCF
            fake.Parent = workspace

            SILENT.target = fake

            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local bag = lp:FindFirstChild("Backpack")
            -- Tool 2 = segunda tool del backpack
            local tools = {}
            if bag then
                for _, t in ipairs(bag:GetChildren()) do
                    if t:IsA("Tool") then tools[#tools + 1] = t end
                end
            end
            if char then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") then
                        local dup = false
                        for _, x in ipairs(tools) do if x == t then dup = true break end end
                        if not dup then tools[#tools + 1] = t end
                    end
                end
            end
            local tool2 = tools[2]
            if hum then pcall(function() hum:UnequipTools() end) end
            task.wait(0.08)
            if tool2 and hum then
                pcall(function() hum:EquipTool(tool2) end)
            else
                equipTool2()
            end
            task.wait(0.15)

            for _ = 1, 3 do
                if fake.Parent then SILENT.target = fake end
                clickMouse()
                task.wait(0.06)
            end

            task.wait(0.05)
            if hum then pcall(function() hum:UnequipTools() end) end
            pcall(function() fake:Destroy() end)
            if not (AUTO.shot or genv.__VANGUARD_AUTOSHOT or SILENT.on or AUTO.trigger) then
                SILENT.target = nil
            end
        end)
        if not ok then warn("[Macro]", err) end
        task.wait(0.05)
        CLICKMACRO.busy = false
    end)
end

UserInputService.InputBegan:Connect(function(input, gpe)
