local function boxBounds(cam, ch)
    local ok2, cf, size = pcall(function() return ch:GetBoundingBox() end)
    if not ok2 or not cf then return nil end
    local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local any = false
    for _, sx in ipairs({ -1, 1 }) do
        for _, sy in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                local p = cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(hx * sx, hy * sy, hz * sz)))
                if p.Z > 0 then
                    any = true
                    if p.X < minX then minX = p.X end
                    if p.Y < minY then minY = p.Y end
                    if p.X > maxX then maxX = p.X end
                    if p.Y > maxY then maxY = p.Y end
                end
            end
        end
    end
    if not any then return nil end
    return minX, minY, maxX, maxY
end

local t = 0
C(RunService.RenderStepped, function(dt)
    t = t + dt
    local cam = workspace.CurrentCamera
    local active = cam ~= nil and (ESP.hl or ESP.box or ESP.name) and enPartida()
    if not active then
        for _, o in pairs(objs) do
            o.hl.Enabled = false
            o.box.Visible = false
            o.bill.Enabled = false
        end
        return
    end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and isEnemy(plr) then
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local head = ch and ch:FindFirstChild("Head")
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                seen[plr] = true
                local o = getObj(plr)
                if ESP.hl then
                    if o.hl.Adornee ~= ch then o.hl.Adornee = ch end
                    o.hl.FillColor = ESP.color
                    o.hl.OutlineColor = ESP.color
                    local s = (math.sin(t * 3) + 1) / 2
                    o.hl.FillTransparency = 0.55
                    o.hl.OutlineTransparency = ESP.pulse and (0.1 + s * 0.2) or 0
                    o.hl.Enabled = true
                else
                    o.hl.Enabled = false
                end
                if ESP.box then
                    local x1, y1, x2, y2 = boxBounds(cam, ch)
                    if x1 then
                        o.box.Position = UDim2.fromOffset(x1, y1)
                        o.box.Size = UDim2.fromOffset(x2 - x1, y2 - y1)
                        o.stroke.Color = ESP.color
                        o.box.Visible = true
                    else
                        o.box.Visible = false
                    end
                else
                    o.box.Visible = false
                end
                if ESP.name and head then
                    o.bill.Adornee = head
                    o.bill.Enabled = true
                    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    local dist = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
                    o.nameL.Text = plr.Name .. " · " .. dist .. "m"
                    o.nameL.TextColor3 = ESP.color
                else
                    o.bill.Enabled = false
                end
            end
        end
    end
    for plr, o in pairs(objs) do
        if not seen[plr] then
            o.hl.Enabled = false
            o.box.Visible = false
            o.bill.Enabled = false
        end
    end
end)

