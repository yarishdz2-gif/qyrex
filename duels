local hitboxAcc = 0
local function applyHitbox(plr)
    if not plr.Character then return end
    local data = HITBOX.applied[plr]
    if not data then data = {} HITBOX.applied[plr] = data end
    local s = math.clamp(HITBOX.size, 2, 10)
    local target = Vector3.new(s, s, s)
    local p = plr.Character:FindFirstChild("Head")
    if p and p:IsA("BasePart") then
        if not data[p] then
            data[p] = { Size = p.Size, Transparency = p.Transparency, CanCollide = p.CanCollide, Massless = p.Massless }
        end
        if math.abs(p.Size.X - s) > 0.2 then
            pcall(function()
                p.Size = target
                p.Transparency = 0.85
                p.CanCollide = false
                p.Massless = true
            end)
        end
    end
end

local function restoreHitbox(plr)
    local data = HITBOX.applied[plr]
    if not data then return end
    for part, info in pairs(data) do
        if part and part.Parent and type(info) == "table" then
            pcall(function()
                part.Size = info.Size
                part.Transparency = info.Transparency or 0
                part.CanCollide = info.CanCollide
                part.Massless = info.Massless or false
            end)
        elseif part and part.Parent and typeof(info) == "Vector3" then
            pcall(function()
                part.Size = info
                part.Transparency = 0
                part.CanCollide = true
                part.Massless = false
            end)
        end
    end
    HITBOX.applied[plr] = nil
end

C(RunService.Heartbeat, function(dt)
    hitboxAcc = hitboxAcc + dt
    if hitboxAcc < 0.6 then return end
    hitboxAcc = 0
    if not HITBOX.on then
        for plr in pairs(HITBOX.applied) do restoreHitbox(plr) end
        return
    end
    local active = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and isEnemy(plr) then
            active[plr] = true
            applyHitbox(plr)
        end
    end
    for plr in pairs(HITBOX.applied) do
        if not active[plr] then restoreHitbox(plr) end
    end
end)

