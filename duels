local hooksInstalled = false
local function installHooks()
    if hooksInstalled then return end
    if not (hookmetamethod and newcclosure and getnamecallmethod and checkcaller) then
        warn("[Vanguard] executor sin hookmetamethod")
        return
    end
    hooksInstalled = true
    local mouse = lp:GetMouse()
    local ws = workspace
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local tgt = SILENT.target
        if tgt and self == ws and not checkcaller() then
            local method = getnamecallmethod()
            if method == "Raycast" then
                local origin, dir, params = ...
                if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 0 then
                    return oldNamecall(self, origin, (tgt.Position - origin).Unit * dir.Magnitude, params)
                end
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                local ray, a, b, c = ...
                if typeof(ray) == "Ray" and ray.Direction.Magnitude > 0 then
                    local newRay = Ray.new(ray.Origin, (tgt.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                    return oldNamecall(self, newRay, a, b, c)
                end
            end
        end
        return oldNamecall(self, ...)
    end))
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if self == mouse and (key == "Hit" or key == "Target") and not checkcaller() then
            local tgt = SILENT.target
            if tgt then
                if key == "Hit" then return CFrame.new(tgt.Position) end
                return tgt
            end
        end
        return oldIndex(self, key)
    end))
end

