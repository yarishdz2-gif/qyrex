findAutoTarget = function()
    local cam = workspace.CurrentCamera
    local myCh = lp.Character
    local myHRP = myCh and myCh:FindFirstChild("HumanoidRootPart")
    local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
    if not cam or not myHum or myHum.Health <= 0 then return nil end

    local vs = cam.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)
    local best, bestDist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local ch = plr.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = aimGetPart(ch) or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if part then
                    local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        local okFov = (not SILENT.useFov) or (d <= (SILENT.fov or 250))
                        if okFov and d < bestDist then
                            best, bestDist = part, d
                        end
                    elseif myHRP then
                        local d3 = (part.Position - myHRP.Position).Magnitude
                        if d3 < bestDist and d3 < 300 then
                            best, bestDist = part, d3
                        end
                    end
                end
            end
        end
    end
    return best
end

