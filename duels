local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
aimParams.IgnoreWater = true

local function aimGetPart(ch)
    if not ch then return nil end
    local map = {
        Cabeza = "Head",
        Torso = "UpperTorso",
        Root = "HumanoidRootPart",
        ["Pie Izq"] = "LeftFoot",
        ["Pie Der"] = "RightFoot",
        ["Mano Izq"] = "LeftHand",
        ["Mano Der"] = "RightHand",
        Pelvis = "LowerTorso",
    }
    local name = map[SILENT.part] or SILENT.part
    local p = ch:FindFirstChild(name)
    if p then return p end
    if SILENT.part == "Torso" then
        return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
    end
    return ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
end

local function aimVisible(cam, myCh, enCh, part)
    if not SILENT.wall then return true end
    if not cam or not myCh or not part then return true end
    aimParams.FilterDescendantsInstances = { myCh }
    local origin = cam.CFrame.Position
    local res = workspace:Raycast(origin, part.Position - origin, aimParams)
    return res == nil or (enCh and res.Instance:IsDescendantOf(enCh))
end

local function isValidTarget(plr)
    if not plr or plr == lp then return false end
    local ch = plr.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if isEnemy(plr) then return true end
    if haveTeams then return false end
    local mid = lp:GetAttribute("DuelMatchId")
    if mid and mid ~= "" then
        return plr:GetAttribute("DuelMatchId") == mid
    end
    return true
end

local function pickTarget()
    local cam = workspace.CurrentCamera
    local myCh = lp.Character
    local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
    if not cam or not myHum or myHum.Health <= 0 then return nil end
    local vs = cam.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local ch = plr.Character
            local part = aimGetPart(ch)
            if part then
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    local okFov = (not SILENT.useFov) or (d <= SILENT.fov)
                    if okFov and d < bestDist and aimVisible(cam, myCh, ch, part) then
                        best, bestDist = part, d
                    end
                end
            end
        end
    end
    return best
end

local function pickAnyEnemy()
    local best, bestDist = nil, math.huge
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local part = aimGetPart(plr.Character)
            if part then
                local d = (part.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    best, bestDist = part, d
                end
            end
        end
    end
    return best
end

