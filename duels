genv.__VANGUARD_STOP = function()
    ESP.hl = false ESP.box = false ESP.name = false
    SILENT.on = false SILENT.target = nil
    AUTO.shot = false AUTO.knife = false AUTO.throw = false AUTO.trigger = false
    genv.__VANGUARD_AUTOSHOT = false
    AIMBOT.on = false
    KILLALL.running = false
    FIRE.on = false
    CLICKMACRO.on = false
    NAMEHIDE.on = false
    stopPlayerAnim()
    stopEmote()
    closeEmotePanel()
    MOVE.speed = false MOVE.infJump = false MOVE.noclip = false MOVE.fly = false MOVE.jumpPower = false MOVE.spin = false MOVE.antiAfk = false
    WORLD.fullbright = false WORLD.nofog = false WORLD.camFovOn = false
    pcall(function()
        lighting.Brightness = oldBrightness
        lighting.ClockTime = oldClock
        lighting.FogEnd = oldFog
        lighting.GlobalShadows = true
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end)
    HITBOX.on = false
    for plr in pairs(HITBOX.applied) do restoreHitbox(plr) end
    stopEmote()
    if fovCircle then pcall(function() fovCircle:Remove() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() holder:Destroy() end)
    pcall(function() boxGui:Destroy() end)
    pcall(function() Window:Destroy() end)
    genv.__VANGUARD_STOP = nil
end

pcall(function()
    if Window.LoadConfig then Window:LoadConfig() end
end)

