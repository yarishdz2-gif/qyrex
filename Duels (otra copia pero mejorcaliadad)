C(UserInputService.InputBegan, function(input, gpe)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then HoldingRMB = true end
end)
C(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then HoldingRMB = false end
end)

C(RunService.Heartbeat, function()
	if KILLALL.running then return end
	local now = os.clock()
	local myCh = lp.Character
	local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
	if not myHum or myHum.Health <= 0 then return end
	local cam = workspace.CurrentCamera

	if AUTO.trigger and cam and (now - lastTrigger) >= 0.04 then
		if not hooksInstalled then pcall(installHooks) end
		local mouse = lp:GetMouse()
		local hitPart = nil
		local under = mouse and mouse.Target
		if under then
			local model = under:FindFirstAncestorOfClass("Model")
			local victim = model and Players:GetPlayerFromCharacter(model)
			if victim and isEnemy(victim) then
				local hum = model:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					hitPart = aimGetPart(model) or under
				end
			end
		end
		if not hitPart then
			local tgt = pickTarget()
			if tgt then
				local sp, onScreen = cam:WorldToViewportPoint(tgt.Position)
				local center = cam.ViewportSize / 2
				if onScreen and (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude < 30 then
					hitPart = tgt
				end
			end
		end
		if hitPart then
			SILENT.target = hitPart
			lastTrigger = now
			clickMouse()
		end
	end
end)

C(RunService.RenderStepped, function()
	if AIMBOT.on and SILENT.target then
		if not AIMBOT.holdRMB or HoldingRMB then
			local cam = workspace.CurrentCamera
			if cam then
				local goal = CFrame.new(cam.CFrame.Position, SILENT.target.Position)
				cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(1 - AIMBOT.smooth, 0.05, 1))
			end
		end
	end
end)

