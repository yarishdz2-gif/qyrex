local objs = {}
local function getObj(plr)
	local o = objs[plr]
	if o then return o end
	local hl = Instance.new("Highlight")
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = false
	hl.Parent = holder
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.Visible = false
	box.Parent = boxGui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Parent = box
	local bill = Instance.new("BillboardGui")
	bill.AlwaysOnTop = true
	bill.Size = UDim2.fromOffset(140, 22)
	bill.StudsOffset = Vector3.new(0, 3.2, 0)
	bill.Enabled = false
	bill.Parent = holder
	local nameL = Instance.new("TextLabel")
	nameL.Size = UDim2.fromScale(1, 1)
	nameL.BackgroundTransparency = 1
	nameL.Font = Enum.Font.GothamBold
	nameL.TextSize = 12
	nameL.TextColor3 = Color3.new(1, 1, 1)
	nameL.TextStrokeTransparency = 0.4
	nameL.Parent = bill
	o = { hl = hl, box = box, stroke = stroke, bill = bill, nameL = nameL }
	objs[plr] = o
	return o
end

C(Players.PlayerRemoving, function(plr)
	local o = objs[plr]
	if o then
		pcall(function() o.hl:Destroy() o.box:Destroy() o.bill:Destroy() end)
		objs[plr] = nil
	end
end)

local tPulse = 0
C(RunService.RenderStepped, function(dt)
	tPulse = tPulse + dt
	local cam = workspace.CurrentCamera
	if not cam or not (ESP.hl or ESP.box or ESP.name) then
		for _, o in pairs(objs) do
			o.hl.Enabled = false
			o.box.Visible = false
			o.bill.Enabled = false
		end
		return
	end
	local seen = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemy(plr) then
			local ch = plr.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			local head = ch and ch:FindFirstChild("Head")
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				seen[plr] = true
				local o = getObj(plr)
				if ESP.hl then
					o.hl.Adornee = ch
					o.hl.FillColor = ESP.color
					o.hl.OutlineColor = ESP.color
					o.hl.FillTransparency = 0.55
					local s = (math.sin(tPulse * 3) + 1) / 2
					o.hl.OutlineTransparency = ESP.pulse and (0.1 + s * 0.25) or 0
					o.hl.Enabled = true
				else
					o.hl.Enabled = false
				end
				if ESP.box then
					local ok2, cf, size = pcall(function() return ch:GetBoundingBox() end)
					if ok2 and cf then
						local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
						local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
						local any = false
						for _, sx in ipairs({ -1, 1 }) do
							for _, sy in ipairs({ -1, 1 }) do
								for _, sz in ipairs({ -1, 1 }) do
									local p = cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(hx * sx, hy * sy, hz * sz)))
									if p.Z > 0 then
										any = true
										minX, minY = math.min(minX, p.X), math.min(minY, p.Y)
										maxX, maxY = math.max(maxX, p.X), math.max(maxY, p.Y)
									end
								end
							end
						end
						if any then
							o.box.Position = UDim2.fromOffset(minX, minY)
							o.box.Size = UDim2.fromOffset(maxX - minX, maxY - minY)
							o.stroke.Color = ESP.color
							o.box.Visible = true
						else
							o.box.Visible = false
						end
					else
						o.box.Visible = false
					end
				else
					o.box.Visible = false
				end
				if ESP.name and head then
					o.bill.Adornee = head
					o.bill.Enabled = true
					local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
					local dist = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
					o.nameL.Text = plr.Name .. " · " .. dist .. "m"
					o.nameL.TextColor3 = ESP.color
				else
					o.bill.Enabled = false
				end
			end
		end
	end
	for plr, o in pairs(objs) do
		if not seen[plr] then
			o.hl.Enabled = false
			o.box.Visible = false
			o.bill.Enabled = false
		end
	end
end)

