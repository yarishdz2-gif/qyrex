C(UserInputService.JumpRequest, function()
	if not MOVE.infJump then return end
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

C(RunService.Heartbeat, function()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if MOVE.speed and hum then hum.WalkSpeed = MOVE.speedVal end
	if MOVE.noclip and char then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end
	if MOVE.fly and hrp and hum then
		hum.PlatformStand = true
		local cam = workspace.CurrentCamera
		if cam then
			local dir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			hrp.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * MOVE.flySpeed or Vector3.zero
		end
	end
end)

----------------------------------------------------------------
-- HITBOX
----------------------------------------------------------------
local hitboxAcc = 0
local function restoreHitbox(plr)
	local data = HITBOX.applied[plr]
	if not data then return end
	for part, info in pairs(data) do
		if part and part.Parent and type(info) == "table" then
			pcall(function()
				part.Size = info.Size
				part.Transparency = info.Transparency or 0
				part.CanCollide = info.CanCollide
				part.Massless = info.Massless or false
			end)
		end
	end
	HITBOX.applied[plr] = nil
end

C(RunService.Heartbeat, function(dt)
	hitboxAcc += dt
	if hitboxAcc < 0.5 then return end
	hitboxAcc = 0
	if not HITBOX.on then
		for plr in pairs(HITBOX.applied) do restoreHitbox(plr) end
		return
	end
	local active = {}
	local s = math.clamp(HITBOX.size, 2, 12)
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemy(plr) and plr.Character then
			active[plr] = true
			local data = HITBOX.applied[plr] or {}
			HITBOX.applied[plr] = data
			local head = plr.Character:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				if not data[head] then
					data[head] = { Size = head.Size, Transparency = head.Transparency, CanCollide = head.CanCollide, Massless = head.Massless }
				end
				if math.abs(head.Size.X - s) > 0.2 then
					pcall(function()
						head.Size = Vector3.new(s, s, s)
						head.Transparency = 0.85
						head.CanCollide = false
						head.Massless = true
					end)
				end
			end
		end
	end
	for plr in pairs(HITBOX.applied) do
		if not active[plr] then restoreHitbox(plr) end
	end
end)

