C(RunService.RenderStepped, function()
	local need = SILENT.on or genv.__QYREX_AUTOSHOT or AUTO.trigger or AIMBOT.on
	if need then
		if not hooksInstalled then pcall(installHooks) end
		if genv.__QYREX_AUTOSHOT then
			SILENT.target = findAutoTarget() or SILENT.target
		else
			SILENT.target = pickTarget() or pickAnyEnemy()
		end
	else
		SILENT.target = nil
	end
	if fovCircle then
		local cam = workspace.CurrentCamera
		if cam and SILENT.showFov and SILENT.useFov and (SILENT.on or genv.__QYREX_AUTOSHOT) then
			local vs = cam.ViewportSize
			fovCircle.Position = Vector2.new(vs.X / 2, vs.Y / 2)
			fovCircle.Radius = SILENT.fov
			fovCircle.Visible = true
		else
			fovCircle.Visible = false
		end
