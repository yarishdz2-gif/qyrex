local function equipOnlyTool1()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	pcall(function() hum:UnequipTools() end)
	task.wait(0.08)
	local bag = lp:FindFirstChild("Backpack")
	if not bag then return false end
	local tool1
	for _, t in ipairs(bag:GetChildren()) do
		if t:IsA("Tool") then tool1 = t break end
	end
	if not tool1 then return false end
	pcall(function() hum:EquipTool(tool1) end)
	return true
end

local function slowTweenTo(hrp, goalCF, duration)
	local tw = TweenService:Create(hrp, TweenInfo.new(duration or 1.5, Enum.EasingStyle.Linear), { CFrame = goalCF })
	tw:Play()
	tw.Completed:Wait()
end

local function doKillAll()
	if KILLALL.running then return end
	KILLALL.running = true
	task.spawn(function()
		if not hooksInstalled then pcall(installHooks) end
		for _, plr in ipairs(Players:GetPlayers()) do
			if not KILLALL.running then break end
			if not isEnemy(plr) then continue end
			local eChar = plr.Character
			local eHRP = eChar and eChar:FindFirstChild("HumanoidRootPart")
			local eHum = eChar and eChar:FindFirstChildOfClass("Humanoid")
			local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
			local myHum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			if eHRP and eHum and eHum.Health > 0 and myHRP and myHum and myHum.Health > 0 then
				SILENT.target = aimGetPart(eChar) or eHRP
				-- espalda
				pcall(function() slowTweenTo(myHRP, eHRP.CFrame * CFrame.new(0, 0, 3.5), KILLALL.tweenTime) end)
				if not KILLALL.running then break end
				equipOnlyTool1()
				task.wait(0.1)
				for _ = 1, KILLALL.clicks do
					if not KILLALL.running then break end
					local still = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
					if not still or still.Health <= 0 then break end
					local eh = plr.Character:FindFirstChild("HumanoidRootPart")
					if eh and myHRP then
						pcall(function() myHRP.CFrame = eh.CFrame * CFrame.new(0, 0, 3.5) end)
					end
					SILENT.target = aimGetPart(plr.Character) or eh
					if not (lp.Character and lp.Character:FindFirstChildOfClass("Tool")) then
						equipOnlyTool1()
					end
					clickMouse()
					task.wait(KILLALL.clickDelay)
				end
			end
		end
		KILLALL.running = false
	end)
end

