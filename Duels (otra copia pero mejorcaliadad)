----------------------------------------------------------------
-- AUTO SHOT LOOP (persistente)
----------------------------------------------------------------
local lastShot, lastTrigger = 0, 0
task.spawn(function()
	while true do
		task.wait(0.03)
		if not genv.__QYREX_AUTOSHOT then continue end
		if KILLALL.running then continue end
		local myHum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if not myHum or myHum.Health <= 0 then continue end
		if not hooksInstalled then pcall(installHooks) end
		local tgt = findAutoTarget()
		if tgt then
			SILENT.target = tgt
			local now = os.clock()
			if (now - lastShot) >= (AUTO.delay or 0.05) then
				lastShot = now
				clickMouse()
			end
		end
	end
end)

