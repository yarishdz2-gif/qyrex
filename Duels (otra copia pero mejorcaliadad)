-- SILENT AIM
----------------------------------------------------------------
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
aimParams.IgnoreWater = true

local function aimGetPart(ch)
	if not ch then return nil end
	if SILENT.part == "Head" then return ch:FindFirstChild("Head") end
	if SILENT.part == "Torso" then
		return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
	end
	return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
end

local function aimVisible(cam, myCh, enCh, part)
	if not SILENT.wall then return true end
	if not cam or not myCh or not part then return true end
	aimParams.FilterDescendantsInstances = { myCh }
	local res = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, aimParams)
	return res == nil or (enCh and res.Instance:IsDescendantOf(enCh))
end

local function pickTarget()
	local cam = workspace.CurrentCamera
	local myCh = lp.Character
	local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
	if not cam or not myHum or myHum.Health <= 0 then return nil end
	local center = cam.ViewportSize / 2
	local best, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemy(plr) then
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local part = ch and aimGetPart(ch)
			if part and hum and hum.Health > 0 then
				local pos, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen and pos.Z > 0 then
					local d = (Vector2.new(pos.X, pos.Y) - Vector2.new(center.X, center.Y)).Magnitude
					local okFov = (not SILENT.useFov) or (d <= SILENT.fov)
					if okFov and d < bestDist and aimVisible(cam, myCh, ch, part) then
						best, bestDist = part, d
					end
				end
			end
		end
	end
	return best
end

local function pickAnyEnemy()
	local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end
	local best, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemy(plr) then
			local part = aimGetPart(plr.Character)
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if part and hum and hum.Health > 0 then
				local d = (part.Position - myHRP.Position).Magnitude
				if d < bestDist then best, bestDist = part, d end
			end
		end
	end
	return best
end

-- auto shot target (sin wall obligatorio)
local function findAutoTarget()
	local cam = workspace.CurrentCamera
	local myCh = lp.Character
	local myHum = myCh and myCh:FindFirstChildOfClass("Humanoid")
	local myHRP = myCh and myCh:FindFirstChild("HumanoidRootPart")
	if not cam or not myHum or myHum.Health <= 0 then return nil end
	local center = cam.ViewportSize / 2
	local best, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and isEnemy(plr) then
				local part = aimGetPart(ch) or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
				if part then
					local pos, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and pos.Z > 0 then
						local d = (Vector2.new(pos.X, pos.Y) - Vector2.new(center.X, center.Y)).Magnitude
						local okFov = (not SILENT.useFov) or (d <= SILENT.fov)
						if okFov and d < bestDist then
							best, bestDist = part, d
						end
					elseif myHRP then
						local d3 = (part.Position - myHRP.Position).Magnitude
						if d3 < bestDist and d3 < 400 then best, bestDist = part, d3 end
					end
				end
			end
		end
	end
	return best
end

local function installHooks()
	if hooksInstalled then return end
	if not (hookmetamethod and newcclosure and getnamecallmethod and checkcaller) then
		warn("[Qyrex] executor sin hookmetamethod")
		return
	end
	hooksInstalled = true
	local mouse = lp:GetMouse()
	local ws = workspace
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local tgt = SILENT.target
		if tgt and self == ws and not checkcaller() then
			local method = getnamecallmethod()
			if method == "Raycast" then
				local origin, dir, params = ...
				if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 0 then
					return oldNamecall(self, origin, (tgt.Position - origin).Unit * dir.Magnitude, params)
				end
			elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
				local ray, a, b, c = ...
				if typeof(ray) == "Ray" and ray.Direction.Magnitude > 0 then
					local newRay = Ray.new(ray.Origin, (tgt.Position - ray.Origin).Unit * ray.Direction.Magnitude)
					return oldNamecall(self, newRay, a, b, c)
				end
			end
		end
		return oldNamecall(self, ...)
	end))
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
		if self == mouse and (key == "Hit" or key == "Target") and not checkcaller() then
			local tgt = SILENT.target
			if tgt then
				if key == "Hit" then return CFrame.new(tgt.Position) end
				return tgt
			end
		end
		return oldIndex(self, key)
	end))
end

local function clickMouse()
	pcall(function()
		if mouse1click then
			mouse1click()
		elseif mouse1press and mouse1release then
			mouse1press()
			task.delay(0.03, function() pcall(mouse1release) end)
		else
			local cam = workspace.CurrentCamera
			local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
			local x, y = vp.X / 2, vp.Y / 2
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			task.delay(0.03, function()
				pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) end)
			end)
		end
	end)
end

